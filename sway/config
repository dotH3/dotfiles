# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu fuzzel
# Monitors
set $output-primary HDMI-A-1
set $output-secondary HDMI-A-2

include /etc/sway/config-vars.d/*

# Fix para compartir pantalla: /etc/sway/config.d/50-systemd-user.conf no
# importa XDG_CURRENT_DESKTOP, así que xdg-desktop-portal nunca elegía el
# backend wlr (ScreenCast) y "Compartir pantalla" quedaba roto.
exec systemctl --user import-environment XDG_CURRENT_DESKTOP
exec hash dbus-update-activation-environment 2>/dev/null && \
        dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP

# Ojo con las comillas: sway parte la línea en cada ";" y la trata como otro
# comando suyo, no como shell. Sin comillas, "exec_always killall -q X; exec X"
# quedaba en dos comandos: el killall (que corre en cada reload) y un exec (que
# solo corre al arrancar la sesión). O sea que cada reload mataba el proceso y
# no lo levantaba de nuevo. Entre comillas va todo junto a sh -c, como se quiere.

# Arrancar waybar (mata instancias previas para evitar duplicados en cada reload).
# El pkill barre los módulos continuos, que no se mueren solos con waybar: se
# quedan bloqueados leyendo cava sin escribir nada, así que nunca les llega el
# EPIPE. El patrón va con [.] a propósito, para que el pkill no matche su propia
# línea de comando (o sea, este mismo sh) y se suicide antes del exec.
exec_always "killall -q waybar; pkill -f 'media-cava[.]sh'; pkill -f 'waybar/cava[.]conf'; exec waybar"

# Arrancar applet de NetworkManager (VPN, wifi) en la bandeja de waybar
exec_always "killall -q nm-applet; exec nm-applet --indicator"

# Arrancar mako (notificaciones)
exec_always "killall -q mako; mako & sleep 1; notify-send 'hey, hii' 'lets code :)'"

# Plank (dock) deshabilitado: en Sway (Wayland puro) bamf no puede mostrar el
# indicador de "app abierta" para ventanas xdg_shell nativas, solo para las que
# corren por XWayland. Config y script quedan intactos por si se retoma.
# exec_always ~/dotfiles/scripts/plank-launch.sh

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/dotfiles/wallpapers/rei.jpg fill
#
# Example configuration:
#
output HDMI-A-1 resolution 1920x1080 position 0,0
output HDMI-A-2 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
input "1160:4639:DELL08B8:00_0488:121F_Touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:keyboard {
    xkb_layout "us,es"
}
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

# Fix disappearing resize cursors: the "default" xcursor theme falls back to
# DMZ-White, which lacks modern cursor names (nwse-resize, ew-resize, etc.).
# Adwaita has full coverage, so use it explicitly for sway/XWayland cursors.
seat seat0 xcursor_theme Adwaita 24

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+w kill

    # Start your launcher
    bindsym $mod+space exec $menu

    # Change keyboard language
    bindsym $mod+F2 input type:keyboard xkb_switch_layout next

    # Screenshot
    bindsym Print exec ~/dotfiles/scripts/screenshot.sh

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Los workspaces con letra llevan prefijo numerico ("4:Q") por dos razones:
    # les da un "num" real, lo que permite usar "workspace number" en los binds,
    # y fija el orden en waybar (que ordena por num; sin el, los workspaces con
    # nombre salian en orden de creacion). La barra muestra solo la letra via
    # format-icons en waybar/config.
    workspace 1   output $output-primary
    workspace 2   output $output-secondary
    workspace 3   output $output-primary
    workspace 4:Q output $output-secondary
    workspace 5:W output $output-primary
    workspace 6:E output $output-secondary
    workspace 7:A output $output-primary
    workspace 8:S output $output-secondary

    # Switch to workspace
    bindsym Alt+1 workspace number 1
    bindsym Alt+2 workspace number 2
    bindsym Alt+3 workspace number 3
    bindsym Alt+q workspace number 4:Q
    bindsym Alt+w workspace number 5:W
    bindsym Alt+e workspace number 6:E
    bindsym Alt+a workspace number 7:A
    bindsym Alt+s workspace number 8:S

    # Move focused container to workspace
    bindsym Alt+Shift+1 move container to workspace number 1
    bindsym Alt+Shift+2 move container to workspace number 2
    bindsym Alt+Shift+3 move container to workspace number 3
    bindsym Alt+Shift+q move container to workspace number 4:Q
    bindsym Alt+Shift+w move container to workspace number 5:W
    bindsym Alt+Shift+e move container to workspace number 6:E
    bindsym Alt+Shift+a move container to workspace number 7:A
    bindsym Alt+Shift+s move container to workspace number 8:S

    # Note: workspaces can have any name you want, not just numbers.

#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    # bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+t exec ~/dotfiles/scripts/floating-toggle-border.sh

    # Swap focus between the tiling area and the floating area
    # bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# bar {
#     position top
#
#     # When the status_command prints a new line to stdout, swaybar updates.
#     # The default just shows the current date and time.
#     status_command while date +'%Y-%m-%d %X'; do sleep 1; done
#
#     colors {
#         statusline #ffffff
#         background #323232
#         inactive_workspace #32323200 #32323200 #5c5c5c
#     }
# }

# Bordes de color sin la barrita de título (que come pantalla).
default_border pixel 2
# Las flotantes sí muestran la barra, para distinguirlas de un vistazo.
default_floating_border normal

# Texto de la barrita en itálica (necesita el prefijo pango: para que sway
# respete el estilo Italic en vez de solo tratarlo como parte del nombre).
font pango:monospace Italic 10

# Barrita de título sin fondo ni borde propio (el 1er y 2do valor van con
# alpha 00): así solo queda visible el "child_border", que es el marco que
# rodea toda la ventana (el que sí queremos conservar). Formato:
# client.<estado> <border> <background> <text> <indicator> <child_border>
client.focused          #4c789900 #28557700 #ffffff #2e9ef4 #285577
client.focused_inactive #33333300 #5f676a00 #ffffff #484e50 #5f676a
client.unfocused        #33333300 #22222200 #888888 #292d2e #222222

### Dock (plank)
#
# Plank corre bajo XWayland, así que matchea por class en vez de app_id.
for_window [class="Plank"] {
    floating enable
    border none
    no_focus
    # Sin sticky el dock es una ventana flotante común y se queda en el workspace
    # donde nació en vez de seguirte.
    sticky enable
}

include /etc/sway/config.d/*
