{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 26, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Sin hueco: los separadores finos del CSS marcan el ritmo
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "custom/mic", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window_OFF", "clock", "group/media"],
    "modules-right": ["idle_inhibitor_OFF", "pulseaudio", "network_OFF", "custom/vpn", "custom/docker", "custom/ai", "cpu", "memory", "temperature", "backlight", "keyboard-state", "sway/language", "battery", "power-profiles-daemon", "custom/reload", "custom/power", "tray"],
    // Modules configuration
    "sway/workspaces": {
        "disable-scroll": true,
        // Una sola lista completa en cada barra: con un unico monitor conectado
        // los workspaces asignados al otro output seguirian ocultos si esto
        // fuese false.
        "all-outputs": true,
        "warp-on-scroll": false,
        // Los workspaces con letra se llaman "4:Q" en sway (el prefijo numerico
        // es lo que fija el orden); aqui se muestra solo la letra.
        "format": "{icon}",
        "format-icons": {
            "1": "1",
            "2": "2",
            "3": "3",
            "4:Q": "Q",
            "5:W": "W",
            "6:E": "E",
            "7:A": "A",
            "8:S": "S"
        },
        // Los 8 siempre visibles. La lista vacia = en todas las salidas; los que
        // no existen en sway (= vacios) reciben la clase .persistent y se pintan
        // en gris desde style.css.
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4:Q": [],
            "5:W": [],
            "6:E": [],
            "7:A": [],
            "8:S": []
        }
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "󰌾",
            "unlocked": "󰿆"
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", "󰍹"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%A, %d %B %Y  %H:%M:%S}"
    },
    "cpu": {
        "format": "{usage}% 󰻠",
        "tooltip": false
    },
    "memory": {
        "format": "{}% 󰍛"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰔏"]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰓅",
            "performance": "󰓅",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) 󰖩",
        "format-ethernet": "{ipaddr}/{cidr} 󰈀",
        "tooltip-format": "{ifname} via {gwaddr} 󰈀",
        "format-linked": "{ifname} (No IP) 󰈀",
        "format-disconnected": "Disconnected 󰖪",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰝟 {icon} {format_source}",
        "format-muted": "󰝟 {format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰄜",
            "portable": "󰄜",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "custom/reload": {
        "format": "󱑞",
        "on-click": "killall waybar; setsid waybar > /dev/null 2>&1 & swaymsg reload;"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power menu (shutdown / restart / suspend / log out)",
        "on-click": "$HOME/.config/waybar/power-menu.sh"
    },
    "custom/docker": {
        "exec": "$HOME/.config/waybar/docker-status.sh",
        "return-type": "json",
        "interval": 15,
        "signal": 9,
        "on-click": "$HOME/.config/waybar/docker-toggle.sh",
        "tooltip": true
    },
    "custom/vpn": {
        "exec": "$HOME/.config/waybar/vpn-status.sh",
        "return-type": "json",
        "interval": 15,
        "signal": 8,
        "on-click": "$HOME/.config/waybar/vpn-toggle.sh",
        "tooltip": true
    },
    "custom/ai": {
        // Cuota restante de OpenCode Go y Claude Code; el script cachea 45s
        "exec": "$HOME/.config/waybar/ai-status.sh",
        "return-type": "json",
        "interval": 60,
        "signal": 11,
        "on-click": "rm -f /tmp/waybar-ai-status.cache; pkill -RTMIN+11 waybar",
        "tooltip": true
    },
    "custom/mic": {
        "exec-if": "$HOME/.config/waybar/mic-status.sh check",
        "exec": "$HOME/.config/waybar/mic-status.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": true
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "custom/media", "custom/cava", "custom/media-next"]
    },
    "custom/media": {
        "exec": "$HOME/.config/waybar/media-status.sh title",
        "return-type": "json",
        "interval": 1,
        "signal": 10,
        "max-length": 45,
        "escape": true,
        "on-click": "$HOME/.config/waybar/media-ctl.sh play-pause",
        "tooltip": true
    },
    "custom/media-prev": {
        "exec": "$HOME/.config/waybar/media-status.sh prev",
        "return-type": "json",
        "interval": 1,
        "signal": 10,
        "on-click": "$HOME/.config/waybar/media-ctl.sh previous",
        "tooltip": true
    },
    "custom/cava": {
        // Sin "interval": salida continua, waybar lee una línea por frame
        "exec": "$HOME/.config/waybar/media-cava.sh",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/media-next": {
        "exec": "$HOME/.config/waybar/media-status.sh next",
        "return-type": "json",
        "interval": 1,
        "signal": 10,
        "on-click": "$HOME/.config/waybar/media-ctl.sh next",
        "tooltip": true
    }
}
